<?xml version="1.0" encoding="utf-8"?>
<!-- The languages the user learns, on the welcome screen and in Settings (see bindLanguageChoice). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/language_choice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <CheckBox
        android:id="@+id/lang_yue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/language_yue"
        android:textSize="@dimen/text_body" />

    <!-- Cantonese is written in traditional characters; this lets it take simplified ones too. -->
    <CheckBox
        android:id="@+id/lang_yue_simplified"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="32dp"
        android:text="@string/language_yue_simplified"
        android:textSize="@dimen/text_body" />

    <!-- Cantonese stroke order: Hong Kong's (where Hok6 has it) or mainland China's. -->
    <RadioGroup
        android:id="@+id/lang_yue_order"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingEnd="8dp"
            android:text="@string/yue_stroke_order"
            android:textSize="@dimen/text_body" />

        <RadioButton
            android:id="@+id/lang_yue_order_hk"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/yue_stroke_order_hk"
            android:textSize="@dimen/text_body" />

        <RadioButton
            android:id="@+id/lang_yue_order_mainland"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/yue_stroke_order_mainland"
            android:textSize="@dimen/text_body" />
    </RadioGroup>

    <CheckBox
        android:id="@+id/lang_cmn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/language_cmn"
        android:textSize="@dimen/text_body" />

    <CheckBox
        android:id="@+id/lang_ja"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/language_ja"
        android:textSize="@dimen/text_body" />

    <CheckBox
        android:id="@+id/lang_ko"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/language_ko"
        android:textSize="@dimen/text_body" />
</LinearLayout>
